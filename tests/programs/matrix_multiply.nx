// Nested loops over 2-D arrays passed by reference.
fn multiply(a: int[3][3], b: int[3][3], c: int[3][3]) -> void {
  var i: int = 0;
  while (i < 3) {
    var j: int = 0;
    while (j < 3) {
      var sum: int = 0;
      var k: int = 0;
      while (k < 3) {
        sum = sum + a[i][k] * b[k][j];
        k = k + 1;
      }
      c[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }
}

fn main() -> int {
  var a: int[3][3];
  var b: int[3][3];
  var c: int[3][3];
  var i: int = 0;
  while (i < 3) {
    var j: int = 0;
    while (j < 3) {
      a[i][j] = i + j + 1;
      b[i][j] = i * 2 - j + 3;
      j = j + 1;
    }
    i = i + 1;
  }
  multiply(a, b, c);
  return (c[0][0] + c[1][1] * 2 + c[2][2] * 3 + c[0][2] - c[2][0]) % 256;
}
