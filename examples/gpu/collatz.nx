// Divergent SIMT kernel: odd and even threads take different branches and the Collatz loop runs
// a different number of iterations per thread, so SIMD efficiency drops below 100%.
fn steps(n: int) -> int {
  var count: int = 0;
  while (n != 1) {
    if (n % 2 == 0) {
      n = n / 2;
    } else {
      n = 3 * n + 1;
    }
    count = count + 1;
  }
  return count;
}

fn kernel(tid: int, threads: int) -> int {
  if (tid % 2 == 0) {
    return steps(tid + 1);
  }
  return tid * 3 + threads;
}

fn main() -> int {
  return kernel(0, 1);
}
